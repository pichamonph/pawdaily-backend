# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น GitHub)

# จาก LINE Developers Console > Messaging API channel > Basic settings
LINE_CHANNEL_SECRET=

# จาก LINE Developers Console > Messaging API channel > Messaging API tab > Issue
LINE_CHANNEL_ACCESS_TOKEN=

# จาก LINE Developers Console > LINE Login channel > Basic settings > Channel ID
# (ตัว channel ที่มี LIFF app อยู่ ไม่ใช่ตัว Messaging API)
LINE_LOGIN_CHANNEL_ID=

# จาก Supabase > Connect > Session pooler
DATABASE_URL=

# พอร์ตที่เซิร์ฟเวอร์รัน (Render จะกำหนดให้อัตโนมัติผ่าน env PORT อยู่แล้ว ใส่ไว้เผื่อรันในเครื่อง)
PORT=3000

# LIFF ID จาก LINE Developers Console > LINE Login channel > LIFF tab
# (ใส่ใน Environment Variables ของ Render ด้วย — ไม่ต้อง prefix VITE_ ใน Render แต่ต้องตั้งชื่อตรงนี้)
VITE_LIFF_ID=
